# Monoracle Veto Bot — Environment Configuration

# Private key of the verifier wallet (must hold MON + approved BASE/QUOTE tokens)
PRIVATE_KEY=0x_your_private_key_here

# Monad WebSocket RPC (testnet) — for sending veto tx
RPC_WS_URL=wss://testnet-rpc.monad.xyz

# Monad HTTP RPC (testnet) — for polling event logs (more reliable than WS)
RPC_HTTP_URL=https://rpc-testnet.monadinfra.com

# Monoracle contract address
ORACLE_ADDRESS=0xF92A55D4e22456C987b3e7AF2E3730b3f5022Ccb

# ---------- Monitored Pairs & Fair Prices ----------
# Format: BASE_TOKEN,QUOTE_TOKEN,FAIR_PRICE
# Fair price is 1e18 fixed-point (e.g. 50 QUOTE per 1 BASE = 50000000000000000000)
# Matches the frontend's default tokens
MONITORED_PAIRS=0xAf078b1cAb4797bA018C8354913eaE22f0f1F719,0x3c34C844EeaeCbc760a74723FC67d8DF49a05093,50000000000000000000

# ---------- Veto Threshold ----------
# Minimum deviation in basis points (1 bp = 0.01%) to trigger a veto.
# The bot computes the break-even deviation dynamically from current gas cost.
# Set this to a non-zero value to enforce a hard floor.
# 0 = fully dynamic (gas-based), 10 = always require at least 0.1%
THRESHOLD_BPS=0

# ---------- Startup Catch-Up ----------
# Number of recent blocks to scan on startup for missed events
CATCH_UP_BLOCKS=10

# ---------- Gas Configuration ----------
# Hardcoded gas limit for veto tx (Monad charges by limit, skip estimateGas)
GAS_LIMIT_VETO=300000

# ---------- MON Price (for profit gate) ----------
# MON price in QUOTE tokens, 1e18 fixed-point.
# The bot converts gas cost from MON to QUOTE using this rate.
# Example: MON=$0.02, QUOTE=$1 → 0.02 QUOTE/MON → 20000000000000000
MON_PRICE_IN_QUOTE=20000000000000000

# ---------- Logging ----------
LOG_LEVEL=INFO
